# Copy to .env and fill in. Frontend (Vite) vars only — these end up in the browser bundle.

# Required: Supabase project → Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: Google Places autocomplete in location fields (falls back to plain text input without it)
VITE_GOOGLE_MAPS_API_KEY=

# Optional: "1" logs data-flow debug output to the console
VITE_DEBUG_FLOW=

# Edge Function secrets do NOT go here. Set them on Supabase:
#   npx supabase secrets set GROQ_API_KEY=... TAVILY_API_KEY=... OPENWEATHER_API_KEY=... \
#     TWELVEDATA_API_KEY=... GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=...
# SUPABASE_URL / SUPABASE_ANON_KEY are injected by Supabase automatically.
