{
	"manifest_version": 3,
	"name": "MorningBrief.AI",
	"version": "1.0.0",
	"description": "나만을 위한 AI 모닝 대시보드 — 매일 아침 맞춤형 브리핑을 새 탭에서 바로 확인하세요",
	"chrome_url_overrides": {
		"newtab": "index.html"
	},
	"background": {
		"service_worker": "background.js"
	},
	"permissions": ["storage"],
	"externally_connectable": {
		"matches": ["https://morningbriefing.dksalstn0621.workers.dev/*", "http://localhost:3000/*"]
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
