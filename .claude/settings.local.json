{
  "env": {
    "CLAUDE_NO_COST_WARNINGS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(node --check src/services/aiService.js)",
      "Bash(node -e \"const p=require\\('./package.json'\\); console.log\\(JSON.stringify\\(p.scripts,null,2\\)\\)\")",
      "PowerShell($c = Get-Content \"DOCS.md\"; \"lines: $\\($c.Count\\)\"; \"--- tail 90 ---\"; $c | Select-Object -Last 90)",
      "Bash(npx vite *)"
    ],
    "deny": []
  },
  "spinnerTipsEnabled": false,
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false
}
